{
  "name": "updown-melody",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack && node scripts/prepare-offline.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src scripts",
    "format": "prettier --write src scripts",
    "sim": "tsx scripts/sim.ts",
    "sim:ai": "tsx scripts/sim-ai.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest",
    "tsx": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "prettier": "latest"
  }
}
